[Unit]
Description=SMR Aforizma timer (gunde 2: Istanbul 12:30 ve 15:35)

[Timer]
# VPS UTC; Istanbul = UTC+3 (kalici, DST yok).
# 09:30 UTC = 12:30 Istanbul · 12:35 UTC = 15:35 Istanbul
# (aksam 20:30 kaldirildi: kullanici aksamlari analiz gonderiyor)
OnCalendar=*-*-* 09:30:00
OnCalendar=*-*-* 12:35:00
# ±2 dk rastgele oynatma (2. slot 15:35 -> max ~15:37; takvim siniri 14 -> guvenli)
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
